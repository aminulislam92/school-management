# Copy this file to .env and fill in your own values. Never commit .env.

# MySQL 8 — database must use utf8mb4
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/school_db"

# Logins created by `npm run db:seed` (development only)
SEED_SUPER_ADMIN_EMAIL="superadmin@example.com"
SEED_SUPER_ADMIN_PASSWORD="change-me-super"
SEED_DEMO_ADMIN_EMAIL="admin@demo.school"
SEED_DEMO_ADMIN_PASSWORD="change-me-admin"
SEED_DEMO_STAFF_PASSWORD="change-me-staff"   # teacher@, accountant@, office@demo.school

# The app's own domain, without port. Schools live on <code>.ROOT_DOMAIN
# Development: localhost  →  http://demo.localhost:3000
# Production:  e.g. yourapp.com
ROOT_DOMAIN="localhost"

# Signs the login cookie. At least 32 random characters; different on every server.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="replace-with-a-long-random-string"
